NIGHT_SUMMARY_THRESHOLD=60
OPPORTUNITY_SCORE_THRESHOLD=80

USER_GMAIL_ADDRESS="pravalikamoraboyina21@gmail.com"
MORNING_ROUTINE_TIME="06:00"
EVENING_ROUTINE_TIME="21:00"
LIVE_SCAN_INTERVAL_MINUTES=5
EMAIL_CHECK_INTERVAL_SECONDS=60

VOICE_ENABLED=True
VOICE_LANG=en

# Mobile Integration Settings (Free Mobile Push & Voice Alerts)
TELEGRAM_BOT_TOKEN=
