# InboxPilot AI Environment Configuration

PROJECT_NAME="InboxPilot AI"
ENVIRONMENT="development"
DEBUG=true

HOST="127.0.0.1"
PORT=8000

DATABASE_URL="sqlite:///./inboxpilot.db"

